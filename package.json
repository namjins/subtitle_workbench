{
  "name": "subtitle-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "subtitle-workbench": "./tools/subtitle-workbench.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "npm run build && node tools/subtitle-workbench.mjs ui",
    "cli": "node tools/subtitle-workbench.mjs",
    "bridge": "node tools/local_bridge_server.mjs",
    "cli:native": "tools/run_native_macos.sh node tools/subtitle-workbench.mjs",
    "doctor": "node tools/subtitle-workbench.mjs doctor",
    "ocr:gate": "node tools/subtitle-workbench.mjs benchmark-ocr --examples-dir \"Subtitle Examples\" --candidate-dir .tmp/ocr-examples-accurate --max-missing 0 --max-extra 0 --max-end-mismatches 0 --max-cer 0.01 --min-fixtures 9",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
