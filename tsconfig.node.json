{
  // A separate program from tsconfig.json on purpose: adding "node" to the
  // app program's types would pull @types/node into the browser code and
  // shift its types (timer handles, Buffer, process). This one covers the
  // published Node surface, which previously had no type checking at all.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Deliberately not strict: this is JSDoc-checked JavaScript, not a
    // TypeScript conversion. strictNullChecks alone would demand a rewrite.
    "strict": false,
    "types": ["node"]
  },
  "include": ["lib/**/*.mjs", "tools/**/*.mjs"]
}
